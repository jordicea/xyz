---
import Base from '../../layouts/Base.astro';
import { langs, getT, type Lang } from '../../i18n';
export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = getT(lang);
---
<Base lang={lang} path="thanks/" noindex={true} title={`${t.th_title} · Jordi Cea`}>
  <main class="wrap thanks">
    <h1>{t.th_title}</h1>
    <p class="lead">{t.th_text}</p>
    <a class="btn pri" href={`/${lang}/`}>{t.th_back}</a>
  </main>
</Base>
