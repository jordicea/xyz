---
import Base from '../../layouts/Base.astro';
import { langs, getT, type Lang } from '../../i18n';
export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = getT(lang);
---
<Base lang={lang} path="privacy/" title={`${t.pv_title} · Jordi Cea`} description={t.meta_desc}>
  <main class="wrap page">
    <h1>{t.pv_title}</h1>
    <div set:html={t.pv_html} />
  </main>
</Base>
